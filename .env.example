# Configurações de Conexão com o Microsoft SQL Server (Busca Vetorial)
# Copie este arquivo para .env na raiz do projeto e preencha com as credenciais reais:
# cp .env.example .env

DRIVER={ODBC Driver 17 for SQL Server}
SERVER=localhost
DATABASE=IA_DATABASE
UID=sa
PWD=sua_senha_segura_aqui
Encrypt=yes
TrustServerCertificate=yes
